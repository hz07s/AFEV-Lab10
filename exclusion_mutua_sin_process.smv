MODULE hilo(y)
VAR
    location : {nc, w, c, exit};
ASSIGN
    init(location) := nc;
    next(location) := case
                          location = nc : {nc, w};
                          location = w & y > 0 : c;
                          location = c : {c, exit};
                          location = exit : nc;
                          TRUE : location;
                      esac;
    next(y) := case
                   location = w & y > 0 : y - 1;
                   location = exit & y = 0 : y + 1;
                   TRUE : y;
               esac;

MODULE main
VAR
    y_main : 0 .. 1;
    prg1 : hilo(y_main);
    prg2 : hilo(y_main);
ASSIGN
    init(y_main) := 1;
